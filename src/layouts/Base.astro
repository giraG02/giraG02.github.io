---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../config';
interface Props { titolo?: string; descrizione?: string }
const { titolo, descrizione = SITE.descrizione } = Astro.props;
const titoloPagina = titolo ? `${titolo} · ${SITE.nome}` : `${SITE.nome} · ${SITE.ruolo}`;
---
<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titoloPagina}</title>
    <meta name="description" content={descrizione} />
    <script is:inline>
      try { var t = localStorage.getItem('tema'); if (t) document.documentElement.dataset.theme = t; } catch (e) {}
    </script>
  </head>
  <body>
    <Header />
    <main><div class="wrap"><slot /></div></main>
    <Footer />
  </body>
</html>
